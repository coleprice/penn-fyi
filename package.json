{
  "name": "penn-fyi",
  "version": "0.1.0",
  "private": true,
  "description": "Nationwide transit awareness over MCP, running on Cloudflare.",
  "type": "module",
  "scripts": {
    "start": "wrangler dev --port 8787",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "cf-typegen": "wrangler types",
    "check": "npm run typecheck && npm test && npm run secrets:scan && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secrets:scan": "secretlint \"**/*\"",
    "etl": "tsx etl/index.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "^0.19.0",
    "gtfs-realtime-bindings": "^2.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.7",
    "@cloudflare/workers-types": "^5.20260727.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@types/node": "^26.1.1",
    "csv-parse": "^7.0.1",
    "prettier": "^3.9.6",
    "secretlint": "^13.0.4",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0",
    "yauzl-promise": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@hono/node-server": "^2.0.11",
    "sharp": "^0.35.3",
    "minimatch": "^10.2.5",
    "brace-expansion": "^5.0.8"
  },
  "license": "MIT"
}
